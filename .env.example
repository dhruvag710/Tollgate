# Which provider routing file to load. The test config routes everything to mock_provider.
PROVIDERS_CONFIG=config/providers.test.yaml
# PROVIDERS_CONFIG=config/providers.yaml

# Real provider keys (only read when PROVIDERS_CONFIG points at providers.yaml).
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Postgres and Redis (the docker compose stack sets these for its own services).
DATABASE_URL=postgresql+asyncpg://tollgate:tollgate@localhost:5432/tollgate
REDIS_URL=redis://localhost:6379/0

# Secret HMAC key for stored API key hashes, at least 16 characters. Changing it
# invalidates every issued key.
KEY_PEPPER=
# Bearer token for /admin/*, at least 16 characters. Unset disables the admin API.
ADMIN_TOKEN=
# The gateway refuses to start with the docker compose stack's development
# KEY_PEPPER/ADMIN_TOKEN unless this is true. Local development only.
DEV_MODE=false

# Per-stage timings in a Server-Timing response header, for diagnostics.
SERVER_TIMING=false

# TPM tokens reserved for the completion of a request that sets no max_tokens.
TPM_DEFAULT_MAX_TOKENS=1024
# Redis connections per gateway process; under a burst, commands wait for one.
REDIS_MAX_CONNECTIONS=100
# Opened at startup, so a cold gateway's first burst doesn't open them mid-burst.
REDIS_MIN_CONNECTIONS=100
# How long a command may wait for a free connection before failing closed (503).
REDIS_POOL_TIMEOUT_S=5
# Connecting to Redis, and each command: a dead or hung Redis is a quick 503.
REDIS_TIMEOUT_S=1

# The usage ledger: a batch insert every interval or batch size, whichever comes
# first; shutdown waits this long for the last ones.
LEDGER_FLUSH_INTERVAL_S=0.5
LEDGER_BATCH_SIZE=200
LEDGER_SHUTDOWN_TIMEOUT_S=10

MAX_REQUEST_BODY_BYTES=1048576
LOG_LEVEL=INFO
WEB_CONCURRENCY=1
