# Which provider routing file to load. The test config routes everything to mock_provider.
PROVIDERS_CONFIG=config/providers.test.yaml
# PROVIDERS_CONFIG=config/providers.yaml

# Real provider keys (only read when PROVIDERS_CONFIG points at providers.yaml).
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Postgres and Redis (the docker compose stack sets these for its own services).
DATABASE_URL=postgresql+asyncpg://tollgate:tollgate@localhost:5432/tollgate
REDIS_URL=redis://localhost:6379/0

# Secret HMAC key for stored API key hashes, at least 16 characters. Changing it
# invalidates every issued key.
KEY_PEPPER=
# Bearer token for /admin/*, at least 16 characters. Unset disables the admin API.
ADMIN_TOKEN=
# The gateway refuses to start with the docker compose stack's development
# KEY_PEPPER/ADMIN_TOKEN unless this is true. Local development only.
DEV_MODE=false

# Per-stage timings in a Server-Timing response header, for diagnostics.
SERVER_TIMING=false

# TPM tokens reserved for the completion of a request that sets no max_tokens.
TPM_DEFAULT_MAX_TOKENS=1024

# The response cache: only requests at or below this temperature are cached (one
# without a temperature runs at the provider's default, 1, so never is).
CACHE_MAX_TEMPERATURE=0.3
# How long an exact-match entry lasts, and the largest answer stored.
EXACT_CACHE_TTL_S=86400
EXACT_CACHE_MAX_ENTRY_BYTES=262144
# Redis connections per gateway process; under a burst, commands wait for one.
REDIS_MAX_CONNECTIONS=100
# Opened at startup, so a cold gateway's first burst doesn't open them mid-burst.
REDIS_MIN_CONNECTIONS=100
# How long a command may wait for a free connection before failing closed (503).
REDIS_POOL_TIMEOUT_S=5
# Connecting to Redis, and each command: a dead or hung Redis is a quick 503.
REDIS_TIMEOUT_S=1

# The usage ledger: a batch insert every interval or batch size, whichever comes
# first; shutdown waits this long for the last ones.
LEDGER_FLUSH_INTERVAL_S=0.5
LEDGER_BATCH_SIZE=200
LEDGER_SHUTDOWN_TIMEOUT_S=10

MAX_REQUEST_BODY_BYTES=1048576
# JSON log lines on stderr, uvicorn's included (this overrides uvicorn's --log-level).
LOG_LEVEL=INFO
# Metrics are per process: keep one worker per replica and scale with replicas.
WEB_CONCURRENCY=1

# The semantic cache (SPEC Phase 2.4), off by default. On only with all four of
# the model, the verifier and their thresholds set; it also needs the semantic
# install (`pip install '.[semantic]'`, or docker-compose.semantic.yml, which
# builds an image with both models and sets all of these as B4 chose them,
# BENCHMARKS.md). The embedding model finds the nearest cached question, a
# candidate at a cosine similarity of at least the threshold; the verifier, an
# NLI cross-encoder, checks it, a hit at a score of at least its threshold.
# Both models run in every gateway process: see BENCHMARKS.md (B5) for the
# memory a replica then needs.
# SEMANTIC_CACHE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# SEMANTIC_CACHE_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# SEMANTIC_CACHE_THRESHOLD=0.68
# SEMANTIC_CACHE_VERIFIER=cross-encoder/nli-deberta-v3-xsmall
# SEMANTIC_CACHE_VERIFIER_REVISION=a150876415327c80daeff35ca6f68f5ed8cf5c24
# SEMANTIC_CACHE_VERIFIER_THRESHOLD=0.90
# How long an entry lasts, and how often expired ones are deleted.
SEMANTIC_CACHE_TTL_S=86400
SEMANTIC_CACHE_SWEEP_S=300
# PyTorch threads per model: one, as a replica runs on one CPU.
SEMANTIC_CACHE_THREADS=1
# Each model has one thread of its own and room for this many calls waiting;
# a request that finds no room skips the layer (a miss that stores nothing).
SEMANTIC_CACHE_QUEUE_SIZE=4
# How long each model's call may take, its wait included, before the request
# gives up on the layer (a miss that stores nothing).
SEMANTIC_CACHE_EMBED_TIMEOUT_MS=100
SEMANTIC_CACHE_VERIFY_TIMEOUT_MS=1000
